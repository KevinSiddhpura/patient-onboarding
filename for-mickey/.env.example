# Firebase Web app config (Project settings > General > Your apps).
# These are public client identifiers, not secrets. Security comes from Auth + Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" connects a dev build to the local Auth and Firestore emulators.
VITE_USE_EMULATORS=false

# Optional. Remote Config minimum fetch interval in seconds.
# Defaults: 10 in dev, 43200 (12 hours) in production builds.
VITE_RC_FETCH_INTERVAL_SECONDS=
